---
import Layout from '../layouts/Layout.astro';
import '../styles/index.css';

const t = {
  en: {
    title: 'Miroslaw Maik — Full Stack Developer',
    available: 'Available for hire',
    role: 'Full Stack Developer',
    bio: "I'm an IT specialist focused on system administration and cybersecurity. I build resilient, minimal, and stable infrastructure that prioritizes digital sovereignty and works well for people.",
    contact: 'Get in touch',
    viewWork: 'View my work',
    focus: 'Focus areas',
    connect: 'Connect',
    work: 'Work',
    skills: ['System Administration', 'Cybersecurity', 'Infrastructure', 'Docker', 'Golang', 'TypeScript', 'Git', 'AI'],
    projects: [
      { title:'Zipline', type:'Tool', period:'2026', href:'https://github.com/miromaik/zipline', desc:'Secure, lightweight P2P file transfer using short 6-digit codes. Focuses on simple pairing, fast local connections, and minimal setup for quick sharing from the terminal.', tags:['Golang','P2P','File Transfer','CLI','Networking','Security','TCP','UX'] },
      { title:'Vow', type:'Tool', period:'2026', href:'https://github.com/miromaik/vow', desc:'A command-line tool that automatically collects debugging information about your project and system, then generates a report ready to share on forums or GitHub Issues.', tags:['Golang','Data Collection','CLI','Diagnostics','Troubleshooting','System Info','Report Generation'] },
      { title:'Protocol Zero', type:'Project', period:'2025', href:'https://github.com/miromaik/protocolzero', desc:'Complete digital privacy, security & sovereignty guide for everyone – 52 chapters covering passwords, 2FA, backups, AI, GDPR, digital legacy, crisis scenarios & more.', tags:['Privacy','Security','Sovereignty','2FA','Backups','GDPR','AI Safety','Crisis Planning'] },
    ],
    colors: { blue:'Blue', purple:'Purple', green:'Green', rose:'Rose' },
    footer: '© 2026 Miroslaw Maik. Silesia, Poland.',
  },
  pl: {
    title: 'Miroslaw Maik — Full Stack Developer',
    available: 'Dostępny do współpracy',
    role: 'Full Stack Developer',
    bio: 'Jestem specjalistą IT skupionym na administracji systemów i cyberbezpieczeństwie. Buduję odporną, minimalistyczną i stabilną infrastrukturę, która stawia na cyfrową suwerenność i dobrze służy ludziom.',
    contact: 'Kontakt',
    viewWork: 'Zobacz projekty',
    focus: 'Obszary',
    connect: 'Połącz się',
    work: 'Projekty',
    skills: ['Administracja systemów', 'Cyberbezpieczeństwo', 'Infrastruktura', 'Docker', 'Golang', 'TypeScript', 'Git', 'AI'],
    projects: [
      { title:'Zipline', type:'Narzędzie', period:'2026', href:'https://github.com/miromaik/zipline', desc:'Bezpieczny, lekki transfer plików P2P z użyciem krótkich 6-cyfrowych kodów. Prosty pairing, szybkie lokalne połączenia i minimalna konfiguracja do szybkiego udostępniania z terminala.', tags:['Golang','P2P','Transfer plików','CLI','Sieci','Bezpieczeństwo','TCP','UX'] },
      { title:'Vow', type:'Narzędzie', period:'2026', href:'https://github.com/miromaik/vow', desc:'Narzędzie wiersza poleceń, które automatycznie zbiera informacje debugowania o projekcie i systemie, a następnie generuje raport gotowy do udostępnienia na forach lub GitHub Issues.', tags:['Golang','Zbieranie danych','CLI','Diagnostyka','Rozwiązywanie problemów','Info o systemie','Raporty'] },
      { title:'Protocol Zero', type:'Projekt', period:'2025', href:'https://github.com/miromaik/protocolzero', desc:'Kompletny poradnik prywatności cyfrowej, bezpieczeństwa i suwerenności – 52 rozdziały obejmujące hasła, 2FA, kopie zapasowe, AI, GDPR, dziedzictwo cyfrowe, scenariusze kryzysowe i więcej.', tags:['Prywatność','Bezpieczeństwo','Suwerenność','2FA','Kopie zapasowe','GDPR','AI Safety','Planowanie kryzysowe'] },
    ],
    colors: { blue:'Niebieski', purple:'Fioletowy', green:'Zielony', rose:'Różowy' },
    footer: '© 2026 Miroslaw Maik. Śląsk, Polska.',
  }
};

const socials = [
  { name:'GitHub', href:'https://github.com/miromaik', icon:'github' },
  { name:'LinkedIn', href:'https://www.linkedin.com/in/miromaik', icon:'linkedin' },
];

const skillsMeta = [
  { icon: 'terminal', colorClass: 'chip-primary' },
  { icon: 'security', colorClass: 'chip-secondary' },
  { icon: 'dns', colorClass: 'chip-tertiary' },
  { icon: 'inventory_2', colorClass: 'chip-surface' },
  { icon: 'integration_instructions', colorClass: 'chip-primary' },
  { icon: 'javascript', colorClass: 'chip-secondary' },
  { icon: 'account_tree', colorClass: 'chip-tertiary' },
  { icon: 'smart_toy', colorClass: 'chip-surface' }
];
---

<Layout title="Miroslaw Maik — Full Stack Developer">
  <div class="page">
    <!-- Top Bar -->
    <div class="top-bar anim-1">
      <button class="icon-btn" id="lang-btn" aria-label="Switch language" title="Language">
        <span class="material-symbols-rounded">translate</span>
      </button>
      <div class="color-picker">
        <button class="icon-btn" id="color-btn" aria-label="Change color" title="Color">
          <span class="material-symbols-rounded">palette</span>
        </button>
        <div class="color-menu" id="color-menu">
          <button class="color-opt" data-color-val="blue" id="copt-blue"><span class="swatch"></span><span class="color-label" data-en="Blue" data-pl="Niebieski">Blue</span></button>
          <button class="color-opt" data-color-val="purple" id="copt-purple"><span class="swatch"></span><span class="color-label" data-en="Purple" data-pl="Fioletowy">Purple</span></button>
          <button class="color-opt" data-color-val="green" id="copt-green"><span class="swatch"></span><span class="color-label" data-en="Green" data-pl="Zielony">Green</span></button>
          <button class="color-opt" data-color-val="rose" id="copt-rose"><span class="swatch"></span><span class="color-label" data-en="Rose" data-pl="Różowy">Rose</span></button>
        </div>
      </div>
      <button class="icon-btn" id="theme-btn" aria-label="Toggle theme" title="Theme">
        <span class="material-symbols-rounded" id="theme-icon">dark_mode</span>
      </button>
    </div>

    <!-- Hero -->
    <section class="hero anim-2" id="hero">
      <div class="avatar-wrap">
        <div class="avatar-ring">
          <img src="/images/avatar.webp" alt="Miroslaw Maik" class="avatar" />
        </div>
      </div>
      <div class="status-pill">
        <span class="status-dot"></span>
        <span data-i18n="available">{t.en.available}</span>
      </div>
      <div class="hero-text">
        <h1 class="display-name">Miroslaw Maik</h1>
        <p class="title-role" data-i18n="role">{t.en.role}</p>
        <p class="bio" data-i18n="bio">{t.en.bio}</p>
      </div>
      <div class="hero-actions">
        <a href="mailto:mail@miromaik.com" class="btn-filled" id="mail-btn">
          <span class="material-symbols-rounded" style="font-size:18px">mail</span>
          <span data-i18n="contact">{t.en.contact}</span>
        </a>
        <a href="#work" class="btn-tonal" id="work-btn">
          <span data-i18n="viewWork">{t.en.viewWork}</span>
          <span class="material-symbols-rounded" style="font-size:18px">expand_more</span>
        </a>
      </div>
    </section>

    <!-- Focus Areas -->
    <section class="anim-3" id="skills">
      <h2 class="section-label" data-i18n="focus">{t.en.focus}</h2>
      <div class="chip-row" id="skills-chips">
        {t.en.skills.map((s, i) => (
          <span class={`chip ${skillsMeta[i].colorClass}`}>
            <span class="material-symbols-rounded" style="font-size: 16px;">{skillsMeta[i].icon}</span>
            <span data-skill-en={s} data-skill-pl={t.pl.skills[i]}>{s}</span>
          </span>
        ))}
      </div>
    </section>

    <!-- Connect -->
    <section class="anim-4" id="socials">
      <h2 class="section-label" data-i18n="connect">{t.en.connect}</h2>
      <div class="social-grid">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noreferrer noopener" class="social-card" id={`social-${s.icon}`}>
            <div class="social-icon" data-icon={s.icon}></div>
            <span class="social-name">{s.name}</span>
            <svg class="social-arrow" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
          </a>
        ))}
      </div>
    </section>

    <!-- Work -->
    <section class="anim-5" id="work">
      <h2 class="section-label" data-i18n="work">{t.en.work}</h2>
      {t.en.projects.map((p, pi) => (
        <a href={p.href} target="_blank" rel="noreferrer" class="project-card" id={`project-${pi}`}>
          <div class="proj-head">
            <div>
              <h3 class="proj-title">{p.title} <span class="proj-type" data-proj-type-en={p.type} data-proj-type-pl={t.pl.projects[pi].type}>· {p.type}</span></h3>
              <span class="proj-period">{p.period}</span>
            </div>
            <svg class="proj-arrow" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
          </div>
          <p class="proj-desc" data-proj-desc-en={p.desc} data-proj-desc-pl={t.pl.projects[pi].desc}>{p.desc}</p>
          <div class="proj-tags">
            {p.tags.map((tag, ti) => (
              <span class="proj-tag" data-tag-en={tag} data-tag-pl={t.pl.projects[pi].tags[ti]}>{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </section>

    <!-- Footer -->
    <footer class="footer anim-6" id="footer">
      <p data-i18n="footer">{t.en.footer}</p>
    </footer>
  </div>
  <div id="i18n-data" style="display:none" set:html={JSON.stringify(t)}></div>
</Layout>

<script is:inline>
(function(){
  var t = JSON.parse(document.getElementById('i18n-data').textContent);

  // ── Color Picker ──
  var colorBtn = document.getElementById('color-btn');
  var colorMenu = document.getElementById('color-menu');

  function pickColor(c) {
    localStorage.setItem('color', c);
    document.documentElement.setAttribute('data-color', c);
    document.querySelectorAll('.color-opt').forEach(function(el) {
      el.classList.toggle('active', el.getAttribute('data-color-val') === c);
    });
    colorMenu.classList.remove('open');
  }

  // Init
  var initColor = localStorage.getItem('color') || 'blue';
  document.documentElement.setAttribute('data-color', initColor);
  var initEl = document.getElementById('copt-' + initColor);
  if (initEl) initEl.classList.add('active');

  // Toggle menu
  colorBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    colorMenu.classList.toggle('open');
  });

  // Color option clicks
  document.querySelectorAll('.color-opt').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      pickColor(btn.getAttribute('data-color-val'));
    });
  });

  // Close on outside click
  document.addEventListener('click', function(e) {
    if (!colorMenu.contains(e.target) && !colorBtn.contains(e.target)) {
      colorMenu.classList.remove('open');
    }
  });

  // ── Theme Toggle ──
  var themeIcon = document.getElementById('theme-icon');
  function isDark() {
    var s = localStorage.getItem('theme') || 'auto';
    if (s === 'auto') return window.matchMedia('(prefers-color-scheme: dark)').matches;
    return s === 'dark';
  }
  function applyTheme() {
    var dark = isDark();
    document.documentElement.classList.toggle('dark', dark);
    if (themeIcon) themeIcon.textContent = dark ? 'light_mode' : 'dark_mode';
  }
  applyTheme();
  document.getElementById('theme-btn').addEventListener('click', function() {
    var next = isDark() ? 'light' : 'dark';
    localStorage.setItem('theme', next);
    document.documentElement.setAttribute('data-theme', next);
    applyTheme();
  });
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
    if ((localStorage.getItem('theme') || 'auto') === 'auto') applyTheme();
  });

  // ── Language Switch ──
  function setLang(lang) {
    document.documentElement.lang = lang;
    localStorage.setItem('lang', lang);
    var d = t[lang];
    document.querySelectorAll('[data-i18n]').forEach(function(el) {
      var k = el.getAttribute('data-i18n');
      if (d[k]) el.textContent = d[k];
    });
    document.querySelectorAll('.chip[data-skill-' + lang + ']').forEach(function(el) {
      el.textContent = el.getAttribute('data-skill-' + lang);
    });
    document.querySelectorAll('[data-proj-type-' + lang + ']').forEach(function(el) {
      el.textContent = '· ' + el.getAttribute('data-proj-type-' + lang);
    });
    document.querySelectorAll('[data-proj-desc-' + lang + ']').forEach(function(el) {
      el.textContent = el.getAttribute('data-proj-desc-' + lang);
    });
    document.querySelectorAll('[data-tag-' + lang + ']').forEach(function(el) {
      el.textContent = el.getAttribute('data-tag-' + lang);
    });
    document.querySelectorAll('.color-label').forEach(function(el) {
      el.textContent = el.getAttribute('data-' + lang);
    });
  }
  var initLang = localStorage.getItem('lang') || 'en';
  if (initLang !== 'en') setLang(initLang);
  document.getElementById('lang-btn').addEventListener('click', function() {
    setLang((document.documentElement.lang || 'en') === 'en' ? 'pl' : 'en');
  });
})();
</script>
