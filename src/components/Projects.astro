---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { useTranslations, languages, defaultLang } from '../i18n/ui';
import '../styles/index.css';

interface Props {
  lang: keyof typeof languages;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const allProjects = await getCollection('projects', ({ data }) => {
  return data.lang === lang;
});

const projects = allProjects.sort((a, b) => a.data.order - b.data.order);

const getLangUrl = (targetLang: string) => {
  if (targetLang === defaultLang) return '/projects/';
  return `/${targetLang}/projects/`;
};
---

<Layout title="Miroslaw Maik — Projects" lang={lang}>
  <div class="page">
    <!-- Top Bar -->
    <div class="top-bar anim-1">
      <div class="nav-links">
        <a href={lang === defaultLang ? '/' : `/${lang}/`} class="nav-link">{t('nav.home')}</a>
        <a href={lang === defaultLang ? '/projects/' : `/${lang}/projects/`} class="nav-link active">{t('nav.projects')}</a>
      </div>

      <!-- Language Switcher -->
      <div class="lang-picker dropdown-wrap">
        <button class="icon-btn" id="lang-btn" aria-label="Switch language" title="Language">
          <span class="material-symbols-rounded">translate</span>
        </button>
        <div class="dropdown-menu" id="lang-menu">
          {Object.entries(languages).map(([code, label]) => (
            <a href={getLangUrl(code)} class={`color-opt ${lang === code ? 'active' : ''}`}>
              <span class="color-label">{label}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="color-picker dropdown-wrap">
        <button class="icon-btn" id="color-btn" aria-label="Change color" title="Color">
          <span class="material-symbols-rounded">palette</span>
        </button>
        <div class="dropdown-menu" id="color-menu">
          <button class="color-opt" data-color-val="blue" id="copt-blue"><span class="swatch"></span><span class="color-label">{t('color.blue')}</span></button>
          <button class="color-opt" data-color-val="purple" id="copt-purple"><span class="swatch"></span><span class="color-label">{t('color.purple')}</span></button>
          <button class="color-opt" data-color-val="green" id="copt-green"><span class="swatch"></span><span class="color-label">{t('color.green')}</span></button>
          <button class="color-opt" data-color-val="rose" id="copt-rose"><span class="swatch"></span><span class="color-label">{t('color.rose')}</span></button>
        </div>
      </div>
      <button class="icon-btn" id="theme-btn" aria-label="Toggle theme" title="Theme">
        <span class="material-symbols-rounded" id="theme-icon">dark_mode</span>
      </button>
    </div>

    <section class="anim-2" id="work" style="padding-top: 32px;">
      <h1 class="display-name" style="font-size: 2rem; margin-bottom: 24px;">{t('section.projects')}</h1>
      
      {projects.map((p) => {
        const link = p.data.links[0]?.url || '#';
        return (
          <a href={link} target="_blank" rel="noreferrer" class="project-card">
            <div class="proj-head">
              <div>
                <h3 class="proj-title">{p.data.title} <span class="proj-type">· {p.data.status}</span></h3>
              </div>
              <svg class="proj-arrow" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
            </div>
            <p class="proj-desc">{p.data.description}</p>
            <div class="proj-tags">
              {p.data.tags.map((tag) => (
                <span class="proj-tag">{tag}</span>
              ))}
            </div>
          </a>
        );
      })}
    </section>

    <!-- Footer -->
    <footer class="footer anim-3" id="footer">
      <p>{t('footer.text')}</p>
    </footer>
  </div>
</Layout>

<script is:inline>
(function(){
  // ── Color Picker ──
  var colorBtn = document.getElementById('color-btn');
  var colorMenu = document.getElementById('color-menu');

  function pickColor(c) {
    localStorage.setItem('color', c);
    document.documentElement.setAttribute('data-color', c);
    document.querySelectorAll('.color-opt[data-color-val]').forEach(function(el) {
      el.classList.toggle('active', el.getAttribute('data-color-val') === c);
    });
    colorMenu.classList.remove('open');
  }

  // Init
  var initColor = localStorage.getItem('color') || 'blue';
  document.documentElement.setAttribute('data-color', initColor);
  var initEl = document.getElementById('copt-' + initColor);
  if (initEl) initEl.classList.add('active');

  // Toggle color menu
  if (colorBtn) {
    colorBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      colorMenu.classList.toggle('open');
      var langMenu = document.getElementById('lang-menu');
      if (langMenu) langMenu.classList.remove('open');
    });
  }

  // Color option clicks
  document.querySelectorAll('.color-opt[data-color-val]').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      pickColor(btn.getAttribute('data-color-val'));
    });
  });

  // ── Lang Picker ──
  var langBtn = document.getElementById('lang-btn');
  var langMenu = document.getElementById('lang-menu');
  if (langBtn) {
    langBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      langMenu.classList.toggle('open');
      if (colorMenu) colorMenu.classList.remove('open');
    });
  }

  // Close on outside click
  document.addEventListener('click', function(e) {
    if (colorMenu && !colorMenu.contains(e.target) && !colorBtn.contains(e.target)) {
      colorMenu.classList.remove('open');
    }
    if (langMenu && !langMenu.contains(e.target) && !langBtn.contains(e.target)) {
      langMenu.classList.remove('open');
    }
  });

  // ── Theme Toggle ──
  var themeIcon = document.getElementById('theme-icon');
  function isDark() {
    var s = localStorage.getItem('theme') || 'auto';
    if (s === 'auto') return window.matchMedia('(prefers-color-scheme: dark)').matches;
    return s === 'dark';
  }
  function applyTheme() {
    var dark = isDark();
    document.documentElement.classList.toggle('dark', dark);
    if (themeIcon) themeIcon.textContent = dark ? 'light_mode' : 'dark_mode';
  }
  applyTheme();
  var themeBtn = document.getElementById('theme-btn');
  if (themeBtn) {
    themeBtn.addEventListener('click', function() {
      var next = isDark() ? 'light' : 'dark';
      localStorage.setItem('theme', next);
      document.documentElement.setAttribute('data-theme', next);
      applyTheme();
    });
  }
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
    if ((localStorage.getItem('theme') || 'auto') === 'auto') applyTheme();
  });
})();
</script>
